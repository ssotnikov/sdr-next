# Normalize line endings in the repository; Makefile and shell scripts must
# keep LF on checkout so they work in WSL from a Windows working tree.
* text=auto
Makefile text eol=lf
*.sh     text eol=lf
*.go     text eol=lf
*.desktop text eol=lf

# Brand assets and fonts are binary: never normalize or diff them.
*.ttf binary
*.ico binary
*.png binary
